#!/bin/zsh
# h32 — launch the local Victure PC530 camera app and open it in the browser.
#   h32            start go2rtc (if needed) and open the viewer
#   h32 stop       stop the go2rtc media server
#   h32 restart    restart it
#   h32 status     show whether it's running
#   h32 log        tail the go2rtc log
#   h32 detect     run the animal detector + recorder (needs go2rtc; Ctrl-C to stop).
#                  Any detector already running is stopped first, so this always
#                  replaces rather than failing on the busy monitor port.
#   h32 detect test-event   fire one test event to verify snapshot+recording
#   h32 detect stop         stop a running detector (incl. a detached one) and exit
#   h32 say <text> speak text through the camera's speaker (German voice Anna)
#   h32 play <f.wav>   play a wav file through the camera's speaker
#
# The app is a self-contained local web app (go2rtc -> WebRTC) at http://127.0.0.1:1984/

DIR="${0:A:h}"
PORT=1984
URL="http://127.0.0.1:${PORT}/"
BIN="$DIR/go2rtc"
CFG="$DIR/go2rtc.yaml"
LOG="$DIR/go2rtc.log"
VENV="$DIR/.venv"

# Site-local settings — camera address/password, alert address (gitignored).
# Exported so go2rtc can expand the ${H32_*} placeholders in go2rtc.yaml.
export H32_DIR="$DIR"
[[ -f "$DIR/local.env" ]] && { set -a; source "$DIR/local.env"; set +a }

up() { nc -z 127.0.0.1 $PORT 2>/dev/null; }

ensure_up() {
  up && return 0
  if [[ -z "$H32_CAMERA_IP" ]]; then
    echo "h32: no camera configured — cp local.env.example local.env and fill it in" >&2
    return 1
  fi
  echo "h32: starting go2rtc…"
  nohup "$BIN" -config "$CFG" >"$LOG" 2>&1 &
  for i in {1..40}; do up && break; sleep 0.25; done
  up
}

start() {
  ensure_up || { echo "h32: FAILED to start — check $LOG" >&2; return 1; }
  echo "h32: up on $URL — opening"
  open "$URL"
}

# Only one detector can exist: the second one cannot bind the monitor port and dies.
# Running `h32 detect` almost always MEANS "replace whatever is running" — often a
# detached one from an earlier session that is no longer attached to any terminal, so
# there is nothing to Ctrl-C. SIGINT rather than SIGKILL so it saves the scenery it has
# learned and shuts the recorder down cleanly.
stop_detector() {
  local pids
  pids=$(pgrep -f "detector/detect.py" 2>/dev/null)
  [[ -z "$pids" ]] && return 0
  echo "h32: a detector is already running (pid ${pids//$'\n'/ }) — stopping it first…"
  # Escalate. SIGTERM as well as SIGINT because a detector started in the background
  # inherited SIGINT as ignored (POSIX, non-interactive shell) — detect.py puts SIGINT
  # back, but a detector from BEFORE that fix is still out there ignoring it.
  local sig
  for sig in INT TERM KILL; do
    kill -$sig ${=pids} 2>/dev/null
    for i in {1..24}; do                     # 6s per signal; it saves state on the way out
      pgrep -f "detector/detect.py" >/dev/null || { echo "h32: stopped."; return 0 }
      sleep 0.25
    done
    [[ $sig == KILL ]] || echo "h32: no response to SIG$sig — escalating" >&2
  done
  echo "h32: could not stop the running detector" >&2
  return 1
}

detect() {
  # `h32 detect stop` — there is no terminal to Ctrl-C when it was started detached.
  if [[ "$1" == "stop" ]]; then
    stop_detector || true
    pgrep -f "detector/detect.py" >/dev/null && echo "h32: detector still running" >&2 \
                                             || echo "h32: no detector running"
    return 0
  fi
  ensure_up || { echo "h32: go2rtc failed — check $LOG" >&2; return 1; }
  stop_detector
  echo "h32: starting detector (Ctrl-C to stop)…"
  exec "$VENV/bin/python" "$DIR/detector/detect.py" "$@"
}

stop() {
  # kill go2rtc started from this dir
  pkill -f "$BIN -config $CFG" && echo "h32: stopped" || echo "h32: was not running"
}

case "${1:-start}" in
  start|"") start ;;
  stop)     stop ;;
  restart)  stop; sleep 0.6; start ;;
  status)   up && echo "h32: running on $URL" || echo "h32: not running" ;;
  log)      tail -n 40 -f "$LOG" ;;
  detect)   shift; detect "$@" ;;
  say)      shift; "$VENV/bin/python" "$DIR/talk.py" --say "$*" --voice Anna ;;
  play)     shift; "$VENV/bin/python" "$DIR/talk.py" "$@" ;;
  *)        echo "usage: h32 [start|stop|restart|status|log|detect|say|play]" ;;
esac
