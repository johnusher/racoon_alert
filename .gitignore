# runtime / downloaded / generated (comments on their own lines!)

# media-server binary — fetch with ./get-go2rtc.sh
go2rtc
go2rtc.log

# python venv (for PTZ capture)
.venv/
__pycache__/
*.pyc

# raw captures may contain credentials/tokens
capture/*.pcap

# detector runtime output + model weights (weights via detector/get-model.sh)
# Recorded footage and snapshots. Ignored as WHOLE DIRECTORIES rather than by
# extension: with one camera these were flat files, but each camera now gets its own
# subdirectory (detector/events/west/…), and a per-extension rule silently stops
# matching one level down. This is a public repo and these frames have real people
# and children in them, so the rule has to be the safe one.
# (`dir/*` rather than `dir/` so the .gitkeep can be re-included — git cannot
#  re-include anything whose PARENT directory is excluded.)
detector/buffer/*
!detector/buffer/.gitkeep
detector/events/*
!detector/events/.gitkeep
detector/*.pt
detector/models/*.pt
detector/samples/_*.jpg
# scenery the detector has learned to ignore — specific to where each camera points,
# so there is one file per camera (scenery.west.json, scenery.south.json, …)
detector/scenery.json
detector/scenery.*.json
# enrolled faces: real people's biometrics. This repo is public — never commit these.
# Deliberately a wildcard: a half-written faces_store.npz.tmp.npz is just as personal.
detector/faces_store*
detector/faces_*.jpg
detector/models/*.onnx
# SpeciesNet's label list — a downloaded artifact like the weights beside it,
# refetched by detector/get-speciesnet.sh
detector/models/speciesnet_labels.txt

.DS_Store

# email credentials
detector/secrets.json
detector/recorder.log

# site-local settings: camera address + password, LAN layout, alert address
local.env

# TTS scratch file from talk.py --say
.talk_say.wav
.talk_say_*.wav   # per-process TTS temp (one detector per camera)

# harvested crops to learn from — real people (incl. children) biometrics; local only
detector/gallery/

# trained species reference embeddings (training data, grows)
detector/species_refs.npz
# labelled animal references from label_animals.py — embeddings of this garden's own
# crops, site-specific and growing, and derived from the gitignored gallery above
detector/animal_refs.npz
detector/overnight.log

# cached inference from detector/imgsz_sweep.py — regenerable, one JSON per clip
detector/sweep_cache/
