# h32 site-local settings — copy to `local.env` and fill in. NEVER commit local.env.
#
#   cp local.env.example local.env
#
# Read by the `h32` launcher (which exports these so go2rtc can expand ${H32_*}
# in go2rtc.yaml) and by the Python tools via h32env.py.

# --- camera ---------------------------------------------------------------
# The camera's address on your LAN, and its ONVIF/RTSP login.
# These cameras ship with admin/123456 — change it in the IPC360 app and put
# the new password here.
H32_CAMERA_IP=192.168.1.100
H32_CAMERA_USER=admin
H32_CAMERA_PASS=

# --- LAN (only needed for the capture/ reverse-engineering tools) ----------
H32_GATEWAY_IP=192.168.1.1
H32_PHONE_IP=
H32_IFACE=en0

# --- two-way talk (send audio to the camera speaker) ----------------------
# The camera's proprietary talk protocol (cc-dd-ee-ff on :23456) tags every
# audio frame with a per-camera device id and a platform constant. Capture
# them once from a real app talk session:
#   sudo ./.venv/bin/python capture/capture_talk.py     # then in the app, hold talk
#   ./.venv/bin/python capture/parse_talk.py --ids       # prints the two values
# Leave blank and talk is simply disabled.
H32_CAMERA_DEVID=
H32_CAMERA_CONST=e4126900

# --- alerts (optional) ----------------------------------------------------
# Where detector e-mail alerts go. SMTP credentials live separately in
# detector/secrets.json (see detector/secrets.json.example).
H32_EMAIL_TO=
